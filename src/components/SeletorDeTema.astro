---
// Substitui o seletor de claro/escuro do Starlight: acrescenta, antes dele, o seletor de tema visual do livro
// (com os temas agrupados por família) e o de paleta de cor do tema. Reproduz a aparência do Select do Starlight,
// que não aceita grupos nem opções que mudam conforme o tema.
import { Icon } from '@astrojs/starlight/components';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import { FAMILIAS, TEMAS } from '../temas.mjs';
import { coresDoTema } from '../cores.mjs';

const grupos = FAMILIAS.map((familia) => ({ ...familia, temas: TEMAS.filter((t) => t.familia === familia.id) }));
const familiaDe = Object.fromEntries(TEMAS.map((t) => [t.id, t.familia]));
const coresDe = Object.fromEntries(TEMAS.map((t) => [t.id, coresDoTema(t.id)]));
const coresIniciais = coresDe[TEMAS[0].id];
---

<ss-seletor-tema data-familias={JSON.stringify(familiaDe)} data-cores={JSON.stringify(coresDe)}>
	<label class="tema">
		<span class="sr-only">Tema visual do livro</span>
		<Icon name="star" class="icone rotulo" />
		<select class="tema" autocomplete="off">
			{
				grupos.map((g) => (
					<optgroup label={g.nome}>
						{g.temas.map((t) => (
							<option value={t.id} selected={t.id === TEMAS[0].id}>
								{t.teste ? `${t.nome} (teste)` : t.nome}
							</option>
						))}
					</optgroup>
				))
			}
		</select>
		<Icon name="down-caret" class="icone seta" />
	</label>
	<label class="cor" hidden={coresIniciais.length === 0}>
		<span class="sr-only">Paleta de cor do tema</span>
		<svg class="icone rotulo" viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" aria-hidden="true">
			<path d="M12 3a9 9 0 0 0 0 18c1.1 0 1.8-.8 1.8-1.7 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-.9.8-1.7 1.8-1.7H17a4 4 0 0 0 4-4c0-4.4-4-8.2-9-8.2Zm-5.5 9a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Zm3-4a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Zm5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Zm3 4a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Z" />
		</svg>
		<select class="cor" autocomplete="off">
			{coresIniciais.map((c, i) => <option value={c.id} selected={i === 0}>{c.nome}</option>)}
		</select>
		<Icon name="down-caret" class="icone seta" />
	</label>
	<span class="compartilhar">
		<button type="button" class="compartilhar" aria-label="Compartilhar esta página com este tema" title="Compartilhar esta página com este tema">
			<svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<circle cx="18" cy="5" r="2.6" /><circle cx="6" cy="12" r="2.6" /><circle cx="18" cy="19" r="2.6" />
				<path d="m8.3 10.8 7.4-4.4M8.3 13.2l7.4 4.4" />
			</svg>
		</button>
		<span class="aviso" role="status" aria-live="polite"></span>
	</span>
</ss-seletor-tema>
<ThemeSelect />

<script>
	type Cor = { id: string; nome: string };
	const raiz = document.documentElement;

	// As paletas de cada tema ficam num arquivo à parte (public/cores/<tema>.css), baixado só quando preciso.
	// Espera o arquivo chegar antes de trocar a cor, para a página não piscar na paleta padrão.
	const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
	const arquivosDeCor = new Map<string, Promise<void>>();
	const carregarCores = (tema: string) => {
		if (!arquivosDeCor.has(tema)) {
			const existente = document.querySelector<HTMLLinkElement>(`link[data-ss-cores="${tema}"]`);
			arquivosDeCor.set(
				tema,
				existente
					? Promise.resolve()
					: new Promise((pronto) => {
							const link = Object.assign(document.createElement('link'), { rel: 'stylesheet', href: `${base}cores/${tema}.css` });
							link.dataset.ssCores = tema;
							link.onload = link.onerror = () => pronto();
							document.head.append(link);
						}),
			);
		}
		return arquivosDeCor.get(tema)!;
	};

	// Imagens (fundos e máscaras, inclusive de ::before e ::after) e fontes que a página usa no estado atual.
	const recursosDaPagina = () => {
		const urls = new Set<string>();
		const fontes = new Set<string>();
		const elementos = [raiz, document.body, ...document.querySelectorAll('header.header, .ss-capa, .ss-capa *, .ss-ambiente *, main, .sidebar-pane')];
		for (const el of elementos) {
			for (const pseudo of [null, '::before', '::after']) {
				const estilo = getComputedStyle(el, pseudo);
				for (const valor of [estilo.backgroundImage, estilo.maskImage, estilo.getPropertyValue('-webkit-mask-image')]) {
					for (const [, url] of (valor || '').matchAll(/url\("?([^")]+)"?\)/g)) urls.add(url);
				}
			}
		}
		for (const el of document.querySelectorAll('body, h1, h2, .sl-link-card .title, header.header')) fontes.add(getComputedStyle(el).fontFamily.split(',')[0].trim());
		return { urls: [...urls], fontes: [...fontes] };
	};

	// Troca de tema sem piscar: aplica a mudança por um instante (sem pintar a tela, tudo na mesma tarefa), anota as
	// imagens e fontes que o tema novo vai usar, desfaz, espera elas chegarem e só então aplica de vez. Na primeira vez
	// que um tema ou cor é aberto, o banner aparecia em branco ou na paleta errada por um instante enquanto a arte baixava.
	const aplicarSemPiscar = async (mudar: () => void) => {
		const antes = { ...raiz.dataset };
		// A sondagem recalcula o estilo duas vezes: as animações do tema atual seriam recriadas do zero (um pulo
		// visível) e as transições dos links disparariam. Guarda o ponto de cada animação e desliga as transições.
		const tempos = new Map<string, CSSNumberish | null>();
		const chave = (a: Animation) => {
			const efeito = a.effect as KeyframeEffect | null;
			return efeito?.target ? `${(a as CSSAnimation).animationName}|${efeito.pseudoElement ?? ''}|${elementos.indexOf(efeito.target)}` : '';
		};
		const elementos = [...document.querySelectorAll('*')];
		for (const a of document.getAnimations()) if ('animationName' in a) tempos.set(chave(a), a.currentTime);
		raiz.dataset.ssSondando = '';
		mudar();
		const { urls, fontes } = recursosDaPagina();
		for (const chave of Object.keys(raiz.dataset)) if (!(chave in antes) && chave !== 'ssSondando') delete raiz.dataset[chave];
		Object.assign(raiz.dataset, antes);
		getComputedStyle(raiz).color;
		for (const a of document.getAnimations()) {
			const t = 'animationName' in a ? tempos.get(chave(a)) : undefined;
			if (t != null && a.currentTime !== t) a.currentTime = t;
		}
		delete raiz.dataset.ssSondando;
		const imagens = urls.map((url) => {
			const img = new Image();
			img.src = url;
			return img.decode().catch(() => {});
		});
		const tipos = fontes.map((nome) => document.fonts.load(`1em ${nome}`).catch(() => {}));
		// Enquanto a arte do tema novo chega, o cursor avisa que a troca está em andamento. Nunca trava: numa rede muito
		// lenta, aplica depois de 3 s mesmo assim (com 1,2 s, uma conexão lenta trocava antes da arte e o banner piscava).
		raiz.style.cursor = 'progress';
		await Promise.race([Promise.all([...imagens, ...tipos]), new Promise((ok) => setTimeout(ok, 3000))]);
		raiz.style.cursor = '';
		mudar();
	};

	class SeletorDeTema extends HTMLElement {
		connectedCallback() {
			const tema = this.querySelector<HTMLSelectElement>('select.tema');
			const cor = this.querySelector<HTMLSelectElement>('select.cor');
			const rotuloCor = this.querySelector<HTMLLabelElement>('label.cor');
			if (!tema || !cor || !rotuloCor) return;
			const familias = JSON.parse(this.dataset.familias || '{}');
			const cores: Record<string, Cor[]> = JSON.parse(this.dataset.cores || '{}');

			// Monta as opções de cor do tema atual e marca a paleta em uso.
			const montarCores = () => {
				const lista = cores[raiz.dataset.ssTema || ''] || [];
				rotuloCor.hidden = lista.length === 0;
				cor.replaceChildren(...lista.map((c) => new Option(c.nome, c.id)));
				if (lista.length) cor.value = raiz.dataset.ssCor || lista[0].id;
			};
			const sincronizar = () => {
				for (const outro of document.querySelectorAll('ss-seletor-tema')) outro.dispatchEvent(new Event('ss-sincronizar'));
			};
			this.addEventListener('ss-sincronizar', () => {
				tema.value = raiz.dataset.ssTema || tema.options[0].value;
				montarCores();
			});

			tema.value = raiz.dataset.ssTema || tema.options[0].value;
			montarCores();

			// Compartilhar: o link desta página com o tema, a paleta e o modo de agora. Só esse link leva o tema; o site
			// segue usando a escolha guardada no navegador, e a barra de endereço de quem abre fica limpa (seletor-tema.js).
			const botao = this.querySelector<HTMLButtonElement>('button.compartilhar');
			const aviso = this.querySelector<HTMLElement>('.aviso');
			let sumir = 0;
			const avisar = (texto: string) => {
				if (!aviso) return;
				aviso.textContent = texto;
				aviso.classList.add('visivel');
				clearTimeout(sumir);
				sumir = window.setTimeout(() => aviso.classList.remove('visivel'), 2200);
			};
			botao?.addEventListener('click', async () => {
				const atual = raiz.dataset.ssTema || tema.options[0].value;
				const link = new URL(location.pathname, location.origin);
				link.searchParams.set('tema', atual);
				if (raiz.dataset.ssCor) link.searchParams.set('cor', raiz.dataset.ssCor);
				// A fantasia é igual no claro e no escuro: o modo só vai no link dos outros temas.
				if (familias[atual] !== 'fantasia') link.searchParams.set('modo', raiz.dataset.theme === 'light' ? 'claro' : 'escuro');
				// No celular, a folha de compartilhar do sistema; no computador, o link vai para a área de transferência.
				if (navigator.share && matchMedia('(pointer: coarse)').matches) {
					try {
						await navigator.share({ title: document.title, url: link.href });
						return;
					} catch (erro) {
						if ((erro as DOMException).name === 'AbortError') return;
					}
				}
				try {
					await navigator.clipboard.writeText(link.href);
					avisar('Link copiado');
				} catch {
					window.prompt('Copie o link desta página com este tema:', link.href);
				}
			});

			tema.addEventListener('change', async () => {
				const novo = tema.value;
				// Cada tema lembra a sua última paleta.
				const lista = cores[novo] || [];
				let salva: string | null = null;
				try {
					localStorage.setItem('ss-tema', novo);
					salva = localStorage.getItem(`ss-cor-${novo}`);
				} catch {}
				const escolhida = lista.find((c) => c.id === salva)?.id || lista[0]?.id;
				if (escolhida && escolhida !== lista[0].id) await carregarCores(novo);
				await aplicarSemPiscar(() => {
					raiz.dataset.ssTema = novo;
					raiz.dataset.ssFamilia = familias[novo];
					if (escolhida) raiz.dataset.ssCor = escolhida;
					else delete raiz.dataset.ssCor;
				});
				sincronizar();
			});

			cor.addEventListener('change', async () => {
				const lista = cores[tema.value] || [];
				if (cor.value !== lista[0]?.id) await carregarCores(tema.value);
				await aplicarSemPiscar(() => {
					raiz.dataset.ssCor = cor.value;
				});
				try {
					localStorage.setItem(`ss-cor-${tema.value}`, cor.value);
				} catch {}
				sincronizar();
			});
		}
	}
	customElements.define('ss-seletor-tema', SeletorDeTema);
</script>

<style>
	ss-seletor-tema {
		display: contents;
	}

	label {
		--rotulo: 0.875rem;
		--seta: 1.25rem;
		--folga: 0.5rem;
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.25rem;
		color: var(--sl-color-gray-2);
	}

	label.tema {
		--largura: var(--largura-tema, 10.5em);
	}

	label.cor {
		--largura: var(--largura-cor, 7em);
	}

	label[hidden] {
		display: none;
	}

	label:hover {
		color: var(--sl-color-white);
	}

	/* Compartilhar: só o ícone, no tom dos seletores; o aviso "Link copiado" aparece embaixo e some sozinho. */
	span.compartilhar {
		position: relative;
		display: flex;
		align-items: center;
	}

	button.compartilhar {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		padding: 0;
		border: 0;
		border-radius: 0.25rem;
		background: none;
		color: var(--sl-color-gray-2);
		font-size: 1.05rem;
		cursor: pointer;
	}

	button.compartilhar:hover,
	button.compartilhar:focus-visible {
		color: var(--sl-color-white);
	}

	.aviso {
		position: absolute;
		top: calc(100% + 0.35rem);
		right: 0;
		padding: 0.25rem 0.6rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 0.25rem;
		background: var(--sl-color-bg-nav);
		color: var(--sl-color-white);
		font-size: var(--sl-text-xs);
		white-space: nowrap;
		pointer-events: none;
		opacity: 0;
		transform: translateY(-0.2rem);
		transition: opacity 0.2s, transform 0.2s;
	}

	.aviso.visivel {
		opacity: 1;
		transform: none;
	}

	.icone {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		pointer-events: none;
	}

	.rotulo {
		font-size: var(--rotulo);
		inset-inline-start: 0;
	}

	.seta {
		font-size: var(--seta);
		inset-inline-end: 0;
	}

	select {
		border: 0;
		padding-block: 0.625rem;
		padding-inline: calc(var(--rotulo) + var(--folga) + 0.25rem) calc(var(--seta) + var(--folga) + 0.25rem);
		margin-inline: calc(var(--folga) * -1);
		width: calc(var(--largura) + var(--folga) * 2);
		background-color: transparent;
		text-overflow: ellipsis;
		color: inherit;
		cursor: pointer;
		appearance: none;
	}

	:is(option, optgroup) {
		background-color: var(--sl-color-bg-nav);
		color: var(--sl-color-gray-1);
	}

	@media (min-width: 50rem) {
		select {
			font-size: var(--sl-text-sm);
		}
	}

	/* Com espaço sobrando, o nome do tema aparece inteiro; entre o celular e o computador largo, os seletores encolhem
	   para caber ao lado da busca sem empurrar o seletor de modo para fora da tela. */
	/* No computador largo há espaço: cada seletor tem a largura do texto escolhido (sem cortar "Mapa do Aventureiro").
	   Sem suporte a field-sizing, a largura automática do select é a da opção mais longa, o que também serve. */
	@media (min-width: 72rem) {
		select {
			field-sizing: content;
			width: auto;
			min-width: 7em;
		}
	}

	@media (min-width: 64rem) and (max-width: 72rem) {
		label {
			--largura-tema: 9.5em;
			--largura-cor: 8em;
		}
	}

	@media (min-width: 50rem) and (max-width: 64rem) {
		label {
			--largura-tema: 8.5em;
			--largura-cor: 6.5em;
		}
	}

	@media (min-width: 50rem) and (max-width: 56rem) {
		label {
			--largura-tema: 6.5em;
			--largura-cor: 6em;
		}
	}
</style>
